# Server
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ehms"

# Redis
REDIS_URL="redis://:redispass@localhost:6379"

# JWT
JWT_SECRET="super-secret-change-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET_NAME="ehms-uploads"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE=true

# OAuth2
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/oauth/google/callback"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Frontend URL
FRONTEND_URL="http://localhost:3000"
