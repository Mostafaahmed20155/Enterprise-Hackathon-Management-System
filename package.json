{
  "name": "enterprise-hackathon-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready bilingual (Arabic RTL + English LTR) hackathon management system",
  "keywords": [
    "hackathon",
    "event-management",
    "rtl",
    "arabic",
    "bilingual",
    "enterprise"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "db:studio": "turbo run db:studio"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "devDependencies": {
    "@turbo/gen": "^2.3.3",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "prisma": "6.19.2",
    "@prisma/client": "6.19.2",
    "@prisma/config": {
      "effect": "3.21.0"
    },
    "path-to-regexp": "^8.4.0",
    "tar": "^7.5.11",
    "@angular-devkit/core": {
      "ajv": "^8.18.0",
      "picomatch": "^4.0.4"
    }
  },
  "packageManager": "npm@10.2.4",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
